SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_WA_NUMBER=+22893628030
NEXT_PUBLIC_STAND=AR114

# Base de données SQLite locale (facultatif).
# Par défaut : <racine du projet>/data/lumasha.db
# En hébergement, pointer vers un volume persistant :
# LUMASHA_DB_PATH=/var/lib/lumasha/lumasha.db
LUMASHA_DB_PATH=

# --- Mode hybride (SQLite caisse ⇄ Supabase site public) ---
# Moteur du serveur :
#   (vide) ou "sqlite" → caisse : base SQLite locale, autoritaire, hors ligne.
#   "supabase"         → site public : lecture seule de l'instantané publié.
LUMASHA_BACKEND=

# Clé service_role Supabase (SERVEUR UNIQUEMENT — ne jamais exposer au client).
# Requise pour publier l'instantané depuis la caisse et le lire côté public.
# Tableau de bord Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
